ROOT = File.expand_path("..", __dir__)
TEAM_ID = "N2C267LBVY"
WORKSPACE = "Nothering.xcworkspace"
PROJECT = "Nothering.xcodeproj"
OUTPUT_DIR = File.join(ROOT, "build/fastlane")
RELEASE_NOTES = File.join(__dir__, "release_notes.txt")
SOURCE_PACKAGES = File.join(OUTPUT_DIR, "SourcePackages")
GITHUB_REPO_URL = "https://github.com/devxoul/nothering"

IOS_APP_ID = "app.nothering.ios"
IOS_WIDGET_ID = "app.nothering.ios.widget"
MAC_APP_ID = "app.nothering.mac"
MAC_EXTENSION_ID = "app.nothering.mac.proxy"

EXTERNAL_TESTER_GROUP = "Beta Testers"
BETA_APP_DESCRIPTION = <<~TEXT.strip
  Nothering lets a Mac use the iPhone's cellular connection without it looking like tethering. The iPhone app runs a small proxy, and the Mac app sends its traffic through it over USB or Personal Hotspot.

  To test, start the proxy on the iPhone, connect a Mac running the Nothering menu bar app, and check that websites load on the Mac.
TEXT

# Beta App Review contact. The email is also the testers' feedback address.
BETA_CONTACT = {
  contact_first_name: "Suyeol",
  contact_last_name: "Jeon",
  contact_email: "devxoul@gmail.com",
  contact_phone: ENV["APP_REVIEW_PHONE_NUMBER"].to_s.empty? ? nil : ENV["APP_REVIEW_PHONE_NUMBER"],
  demo_account_required: false
}.compact

VERSION_PATTERN = /("CFBundleShortVersionString": ")([^"]+)(")/

before_all do
  # Temporary keychain + readonly match on CI runners.
  setup_ci if is_ci
end

desc "Set the marketing version in Project.swift and commit it"
lane :bump do |options|
  version = options[:version].to_s
  UI.user_error!("Usage: fastlane bump version:X.Y.Z") unless version.match?(/\A\d+\.\d+\.\d+\z/)

  path = File.join(ROOT, "Project.swift")
  content = File.read(path)
  UI.user_error!("Couldn't find CFBundleShortVersionString in Project.swift") unless content.match?(VERSION_PATTERN)
  if current_version == version
    UI.important("Project.swift is already at #{version}, nothing to commit")
    next
  end

  File.write(path, content.sub(VERSION_PATTERN, "\\1#{version}\\3"))
  git_commit(path: path, message: "Bump version to #{version}")
end

desc "Release both apps: notarized Mac app + CLI in build/fastlane/, iPhone app to TestFlight"
lane :release do
  api_key = app_store_connect_api_key
  build_number = next_build_number(api_key)
  # Mac first: it has no public side effect, so most failures happen before the TestFlight upload.
  build_mac(api_key, build_number)
  build_ios(api_key, build_number)
end

platform :ios do
  desc "Build the iPhone app and upload it to TestFlight"
  lane :beta do |options|
    api_key = app_store_connect_api_key
    build_ios(api_key, options[:build_number] || next_build_number(api_key))
  end

  desc "Upload the App Store listing (metadata, screenshots, age rating) for the current version"
  lane :metadata do
    deliver(api_key: app_store_connect_api_key, app_version: current_version)
  end

  desc "Upload the listing and submit a TestFlight build for App Store review (default: the current version's latest build)"
  lane :submit do |options|
    api_key = app_store_connect_api_key
    version = current_version
    build_number = options[:build_number] ||
      latest_testflight_build_number(api_key: api_key, app_identifier: IOS_APP_ID, version: version)
    # deliver's own `reject_if_possible` runs after it renames the edit version, which a version in review rejects.
    cancel_review_submission
    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build_number.to_s,
      submit_for_review: true,
      automatic_release: true
    )
  end

  # App Store Connect API keys can't edit App Privacy, so this one logs in with an Apple ID (FASTLANE_USER).
  desc "Set the App Privacy answers from app_privacy_details.json"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: IOS_APP_ID,
      json_path: File.join(ROOT, "fastlane/app_privacy_details.json")
    )
  end
end

platform :mac do
  desc "Build the menu bar app and CLI with Developer ID, notarize them, and zip them"
  lane :release do |options|
    build_mac(app_store_connect_api_key, options[:build_number])
  end
end

def current_version
  File.read(File.join(ROOT, "Project.swift"))[VERSION_PATTERN, 2]
end

# Pulls a version still in App Review so the new release can replace it. Needs the API key token set.
def cancel_review_submission
  app = Spaceship::ConnectAPI::App.find(IOS_APP_ID)
  platform = Spaceship::ConnectAPI::Platform::IOS
  submission = app.get_in_progress_review_submission(platform: platform)
  return unless submission

  submission.cancel_submission
  UI.message("Cancelling the App Store review submission in progress...")
  sleep(15) while app.get_in_progress_review_submission(platform: platform)
end

# Both apps share one build number, taken from TestFlight so it always increases.
def next_build_number(api_key)
  latest_testflight_build_number(api_key: api_key, app_identifier: IOS_APP_ID, initial_build_number: 0) + 1
end

def generate_project(build_number)
  ENV["TUIST_BUILD_NUMBER"] = build_number.to_s if build_number
  sh("cd #{ROOT.shellescape} && tuist generate --no-open")
end

# Developer ID profiles only grant the `-systemextension` variants of the
# Network Extension entitlement, so release builds sign with a rewritten copy.
def developer_id_entitlements(path)
  output = "Derived/fastlane/#{File.basename(path)}"
  FileUtils.mkdir_p(File.join(ROOT, File.dirname(output)))
  content = File.read(File.join(ROOT, path))
    .gsub("<string>app-proxy-provider</string>", "<string>app-proxy-provider-systemextension</string>")
    .gsub("<string>dns-proxy</string>", "<string>dns-proxy-systemextension</string>")
  File.write(File.join(ROOT, output), content)
  output
end

def build_ios(api_key, build_number)
  generate_project(build_number)

  match(type: "appstore", platform: "ios", app_identifier: [IOS_APP_ID, IOS_WIDGET_ID], api_key: api_key)
  profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
  { "NotheringiOS" => IOS_APP_ID, "NotheringiOSWidget" => IOS_WIDGET_ID }.each do |target, bundle_id|
    update_code_signing_settings(
      path: PROJECT,
      targets: [target],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      sdk: "iphoneos*",
      code_sign_identity: "Apple Distribution",
      profile_name: profiles[bundle_id]
    )
  end

  build_app(
    workspace: WORKSPACE,
    scheme: "NotheringiOS",
    configuration: "Release",
    export_method: "app-store",
    output_directory: OUTPUT_DIR
  )

  changelog = File.exist?(RELEASE_NOTES) ? File.read(RELEASE_NOTES).strip : ""
  upload_to_testflight(
    api_key: api_key,
    changelog: changelog.empty? ? nil : changelog,
    # Beta App Review rejects external submissions without test information and a contact.
    beta_app_description: BETA_APP_DESCRIPTION,
    beta_app_feedback_email: BETA_CONTACT[:contact_email],
    beta_app_review_info: BETA_CONTACT,
    # External groups need a processed build, so wait for it and submit it for beta review.
    distribute_external: true,
    groups: [EXTERNAL_TESTER_GROUP],
    notify_external_testers: true
  )
end

def build_mac(api_key, build_number)
  generate_project(build_number)
  version = current_version

  match(type: "developer_id", platform: "macos", app_identifier: [MAC_APP_ID, MAC_EXTENSION_ID], api_key: api_key)
  profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
  {
    "NotheringMenuBar" => [MAC_APP_ID, "MacApp/App.entitlements"],
    "NotheringProxyExtension" => [MAC_EXTENSION_ID, "MacProxy/Proxy.entitlements"],
  }.each do |target, (bundle_id, entitlements)|
    update_code_signing_settings(
      path: PROJECT,
      targets: [target],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      sdk: "macosx*",
      code_sign_identity: "Developer ID Application",
      profile_name: profiles[bundle_id],
      entitlements_file_path: developer_id_entitlements(entitlements)
    )
  end
  # The CLI has no restricted entitlements, so it needs the certificate but no profile.
  update_code_signing_settings(
    path: PROJECT,
    targets: ["NotheringMac"],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    sdk: "macosx*",
    code_sign_identity: "Developer ID Application"
  )

  app_path = build_app(
    workspace: WORKSPACE,
    scheme: "NotheringMenuBar",
    configuration: "Release",
    export_method: "developer-id",
    output_directory: OUTPUT_DIR,
    # A known location, so the Sparkle tools resolved alongside the framework can be found.
    cloned_source_packages_path: SOURCE_PACKAGES
  )
  notarize(package: app_path, api_key: api_key)
  app_zip = File.join(OUTPUT_DIR, "Nothering-#{version}.zip")
  sh("ditto", "-c", "-k", "--keepParent", app_path, app_zip)
  generate_appcast(app_zip, version)

  derived_data = File.join(OUTPUT_DIR, "DerivedData")
  sh(
    "xcodebuild", "build", "-quiet",
    "-workspace", File.join(ROOT, WORKSPACE),
    "-scheme", "NotheringMac",
    "-configuration", "Release",
    "-destination", "generic/platform=macOS",
    "-derivedDataPath", derived_data,
    "OTHER_CODE_SIGN_FLAGS=--timestamp",
    # Plain builds add get-task-allow (archive export strips it); notarization rejects it.
    "CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO"
  )
  # A bare binary can't be stapled; Gatekeeper looks the ticket up online instead.
  cli_zip = File.join(OUTPUT_DIR, "nothering-cli-#{version}.zip")
  sh("ditto", "-c", "-k", File.join(derived_data, "Build/Products/Release/nothering"), cli_zip)
  notarize(package: cli_zip, api_key: api_key, skip_stapling: true)

  UI.success("Notarized: #{app_zip}, #{cli_zip}")
end

# Writes build/fastlane/appcast.xml for the GitHub Release; the app's feed URL follows the latest release.
# Signs with SPARKLE_PRIVATE_KEY on CI, or the `app.nothering` keychain item from `generate_keys` locally.
def generate_appcast(app_zip, version)
  archives = File.join(OUTPUT_DIR, "appcast")
  FileUtils.rm_rf(archives)
  FileUtils.mkdir_p(archives)
  FileUtils.cp(app_zip, archives)

  tool = File.join(SOURCE_PACKAGES, "artifacts/sparkle/Sparkle/bin/generate_appcast").shellescape
  key = ENV["SPARKLE_PRIVATE_KEY"].to_s.empty? ? "--account app.nothering" : "--ed-key-file -"
  command = [
    tool, key,
    "--download-url-prefix", "#{GITHUB_REPO_URL}/releases/download/#{version}/",
    "--full-release-notes-url", "#{GITHUB_REPO_URL}/releases/tag/#{version}",
    "--link", GITHUB_REPO_URL,
    "-o", File.join(OUTPUT_DIR, "appcast.xml").shellescape,
    archives.shellescape,
  ].join(" ")
  # Piped in so the key never shows up in the logged command.
  command = %(printf '%s' "$SPARKLE_PRIVATE_KEY" | #{command}) unless ENV["SPARKLE_PRIVATE_KEY"].to_s.empty?
  sh(command)
end
